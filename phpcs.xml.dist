<?xml version="1.0"?>
<ruleset name="Bookora">
    <description>Coding standards for the Bookora plugin (WordPress + PSR-12 + PHP 8.2 compatibility).</description>

    <file>app</file>
    <file>bookora.php</file>
    <file>uninstall.php</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/assets/build/*</exclude-pattern>
    <exclude-pattern>*/tests/*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <!-- WordPress standards. -->
    <rule ref="WordPress-Extra"/>
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="bookora"/>
            </property>
        </properties>
    </rule>

    <!-- Allow PSR-4 class file naming (we autoload via Composer, not WP file conventions). -->
    <rule ref="WordPress.Files.FileName">
        <severity>0</severity>
    </rule>

    <!-- $default / $class as parameter names mirror WordPress core's own API (get_option). -->
    <rule ref="Universal.NamingConventions.NoReservedKeywordParameterNames">
        <severity>0</severity>
    </rule>

    <!-- Enforce our table/prefix conventions. -->
    <rule ref="WordPress.DB.PreparedSQL"/>
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="bookora"/>
                <element value="Bookora"/>
                <element value="BOOKORA"/>
            </property>
        </properties>
    </rule>

    <!-- PHP cross-version compatibility. -->
    <config name="testVersion" value="8.2-"/>
    <rule ref="PHPCompatibilityWP"/>

    <config name="minimum_wp_version" value="6.8"/>
</ruleset>
