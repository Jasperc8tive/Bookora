includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: 6
    paths:
        - app
        - bookora.php
        - uninstall.php
    bootstrapFiles:
        - tests/phpstan/bootstrap.php
    treatPhpDocTypesAsCertain: false
    excludePaths:
        - vendor/*
        - node_modules/*
        - assets/build/*
        # Elementor widget classes extend \Elementor\Widget_Base, which is not a
        # plugin dependency; all real logic lives in the analysed WidgetRenderer.
        - app/Elementor/Widgets/*
