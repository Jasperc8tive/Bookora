includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: 6
    paths:
        - app
        - bookora.php
        - uninstall.php
    bootstrapFiles:
        - tests/phpstan/bootstrap.php
    treatPhpDocTypesAsCertain: false
    excludePaths:
        - vendor/*
        - node_modules/*
        - assets/build/*
